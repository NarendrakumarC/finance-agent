# ==============================================================================
# 1. OPENAI CONFIGURATION (Primary for OpenAI Agents SDK)
# ==============================================================================
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenAI Agents SDK Telemetry & Tracing
OPENAI_AGENTS_DISABLE_TRACING=false

# ==============================================================================
# 2. HUGGING FACE CONFIGURATION (Models, FinBERT Sentiment, Inference Endpoints)
# ==============================================================================
HF_TOKEN=hf_your_huggingface_access_token_here
HUGGINGFACEHUB_API_TOKEN=hf_your_huggingface_access_token_here

# Default Hugging Face Models (e.g., ProsusAI/finbert for analyze_sentiment or Qwen/Llama via HF Router)
HF_SENTIMENT_MODEL=ProsusAI/finbert
HF_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
HF_INFERENCE_ENDPOINT=https://router.huggingface.co/v1

# ==============================================================================
# 3. ALTERNATIVE / MULTI-PROVIDER LLM KEYS (via LiteLLM / OpenAI-compatible SDK)
# ==============================================================================
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# AWS Bedrock (Optional if routing via Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# ==============================================================================
# 4. FINANCIAL DATA & NEWS SEARCH APIS (Optional Fallbacks for yfinance)
# ==============================================================================
# Yahoo Finance (yfinance) works without an API key, but these are useful fallbacks:
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
FINNHUB_API_KEY=your_finnhub_key_here
FMP_API_KEY=your_financial_modeling_prep_key_here
POLYGON_API_KEY=your_polygon_io_key_here

# News & Web Search Fallbacks (for search_recent_news tool)
TAVILY_API_KEY=tvly-your_tavily_key_here
NEWS_API_KEY=your_newsapi_org_key_here
SERPER_API_KEY=your_serper_dev_key_here

# ==============================================================================
# 5. APPLICATION & VALUATION DEFAULTS (Project Runtime Settings)
# ==============================================================================
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=3600

# Default DCF Valuation Assumptions (used in tools/valuation_tools.py)
DEFAULT_DISCOUNT_RATE=0.10
DEFAULT_TERMINAL_GROWTH_RATE=0.03
DEFAULT_PROJECTION_YEARS=5